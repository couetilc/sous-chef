# Database Configuration (AWS RDS)
{% if use_aws_secrets | default(true) %}
DJANGO_DB_NAME={{ db_credentials.dbname }}
DJANGO_DB_USER={{ db_credentials.username }}
DJANGO_DB_PASSWORD={{ db_credentials.password }}
DJANGO_DB_HOST={{ db_credentials.host }}
DJANGO_DB_PORT={{ db_credentials.port }}
{% else %}
DJANGO_DB_NAME={{ db_name | default('api') }}
DJANGO_DB_USER={{ db_user | default('dbuser') }}
DJANGO_DB_PASSWORD={{ db_password }}
DJANGO_DB_HOST={{ db_host }}
DJANGO_DB_PORT={{ db_port | default('5432') }}
{% endif %}

# Django Configuration
{% if use_aws_secrets | default(true) %}
DJANGO_SECRET_KEY={{ django_secret.secret_key }}
{% else %}
DJANGO_SECRET_KEY={{ django_secret_key }}
{% endif %}
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS={{ allowed_hosts | default('*') }}
DJANGO_SERVER_IP=0.0.0.0
DJANGO_SERVER_PORT=8000

# Environment
ENVIRONMENT={{ environment }}
